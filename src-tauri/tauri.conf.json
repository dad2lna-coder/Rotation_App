{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OperationalMovements",
  "version": "1.0.0",
  "identifier": "com.dad2lna.operationalmovements",
  "mainBinaryName": "OperationalMovements",
  "build": {
    "frontendDist": "../www",
    "beforeDevCommand": "node scripts/prepare-frontend.js",
    "beforeBuildCommand": "node scripts/prepare-frontend.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Operational Movements Discovery Dashboard",
        "width": 1440,
        "height": 920,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
